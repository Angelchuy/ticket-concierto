            UPDATE ticket
            SET firstName = %s,
                lastName = %s,
                numberOfPeople = %s,
                ticketType = %s
            WHERE id = %s
        """
        cursor.execute(
            query,
            (firstName, lastName, numberOfPeople, ticketType, id)
        )
